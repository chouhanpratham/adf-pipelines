{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "EduSyncDataFactoryPratham"
		},
		"AzureLogFile_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureLogFile'"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/EduSyncPipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LogETL",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "LogETL",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"LogInput": {},
									"LogOutput": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/LogETL')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/LogJson')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureLogFile",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "edusync-logs (3).json",
						"container": "container"
					}
				},
				"schema": {
					"type": "object",
					"properties": {
						"@t": {
							"type": "string"
						},
						"@mt": {
							"type": "string"
						},
						"MachineName": {
							"type": "string"
						},
						"ThreadId": {
							"type": "integer"
						},
						"Application": {
							"type": "string"
						},
						"@l": {
							"type": "string"
						},
						"@tr": {
							"type": "string"
						},
						"@sp": {
							"type": "string"
						},
						"EventId": {
							"type": "object",
							"properties": {
								"Id": {
									"type": "integer"
								},
								"Name": {
									"type": "string"
								}
							}
						},
						"SourceContext": {
							"type": "string"
						},
						"RequestId": {
							"type": "string"
						},
						"RequestPath": {
							"type": "string"
						},
						"ConnectionId": {
							"type": "string"
						}
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureLogFile')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/LogOutputFile')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureLogFile",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "edited.json",
						"container": "logs"
					}
				},
				"schema": {
					"type": "object",
					"properties": {
						"@t": {
							"type": "string"
						},
						"@mt": {
							"type": "string"
						},
						"MachineName": {
							"type": "string"
						},
						"ThreadId": {
							"type": "integer"
						},
						"Application": {
							"type": "string"
						},
						"@l": {
							"type": "string"
						},
						"@tr": {
							"type": "string"
						},
						"@sp": {
							"type": "string"
						},
						"EventId": {
							"type": "object",
							"properties": {
								"Id": {
									"type": "integer"
								},
								"Name": {
									"type": "string"
								}
							}
						},
						"SourceContext": {
							"type": "string"
						},
						"RequestId": {
							"type": "string"
						},
						"RequestPath": {
							"type": "string"
						},
						"ConnectionId": {
							"type": "string"
						}
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureLogFile')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/OutputSink')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureLogFile",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "edited.json",
						"container": "container"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureLogFile')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureLogFile')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "EduSyncProject Log FIle",
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('AzureLogFile_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LogETL')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "LogJson",
								"type": "DatasetReference"
							},
							"name": "LogInput"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "OutputSink",
								"type": "DatasetReference"
							},
							"name": "LogOutput"
						}
					],
					"transformations": [
						{
							"name": "select1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          {@t} as string,",
						"          {@mt} as string,",
						"          MachineName as string,",
						"          ThreadId as integer,",
						"          Application as string,",
						"          {@l} as string,",
						"          {@tr} as string,",
						"          {@sp} as string,",
						"          EventId as (Id as integer, Name as string),",
						"          SourceContext as string,",
						"          RequestId as string,",
						"          RequestPath as string,",
						"          ConnectionId as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     documentForm: 'documentPerLine') ~> LogInput",
						"LogInput select(mapColumn(",
						"          timestamp = {@t},",
						"          messageTemplate = {@mt},",
						"          MachineName,",
						"          ThreadId,",
						"          Application,",
						"          SourceContext,",
						"          RequestId,",
						"          RequestPath,",
						"          ConnectionId",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> LogOutput"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/LogJson')]",
				"[concat(variables('factoryId'), '/datasets/OutputSink')]"
			]
		}
	]
}
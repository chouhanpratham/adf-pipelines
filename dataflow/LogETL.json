{
	"name": "LogETL",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "LogJson",
						"type": "DatasetReference"
					},
					"name": "LogInput"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "LogOutputFile",
						"type": "DatasetReference"
					},
					"name": "LogOutput"
				}
			],
			"transformations": [
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {@t} as string,",
				"          {@mt} as string,",
				"          MachineName as string,",
				"          ThreadId as integer,",
				"          Application as string,",
				"          {@l} as string,",
				"          {@tr} as string,",
				"          {@sp} as string,",
				"          EventId as (Id as integer, Name as string),",
				"          SourceContext as string,",
				"          RequestId as string,",
				"          RequestPath as string,",
				"          ConnectionId as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> LogInput",
				"LogInput select(mapColumn(",
				"          timestamp = {@t},",
				"          messageTemplate = {@mt},",
				"          MachineName,",
				"          ThreadId,",
				"          Application,",
				"          logLevel = {@l},",
				"          EventId,",
				"          SourceContext,",
				"          RequestId,",
				"          RequestPath,",
				"          ConnectionId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {@t} as string,",
				"          {@mt} as string,",
				"          MachineName as string,",
				"          ThreadId as integer,",
				"          Application as string,",
				"          {@l} as string,",
				"          {@tr} as string,",
				"          {@sp} as string,",
				"          EventId as (Id as integer, Name as string),",
				"          SourceContext as string,",
				"          RequestId as string,",
				"          RequestPath as string,",
				"          ConnectionId as string",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> LogOutput"
			]
		}
	}
}